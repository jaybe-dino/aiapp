# 혜택AI MVP 환경변수 예시 — 실제 값은 .env 로 복사해서 사용하세요.

# 서버 포트
PORT=3000

# AI 공급자(Model Gateway). 비워두면 결정형 mock 답변으로 동작합니다(키 없이 실행 가능).
# 실제 Claude를 붙이려면 ANTHROPIC_API_KEY 를 채우세요(콘솔에서 발급).
ANTHROPIC_API_KEY=
# 답변 모델 등급. 기본 fast = Claude Haiku 4.5(가장 저렴, $1/$5 per 1M).
#   fast=저비용(Haiku 4.5) · balanced=Sonnet · reasoning=Opus. 매핑은 src/modules/ai/provider.ts 참고
AI_MODEL_TIER=fast
# AI 일일 대화 상한(사용자당). 비용·어뷰징 방어. 초과 시 LLM 호출 없이 안내.
DAILY_CHAT_CAP=200
# 무료 대화 수(수익화 게이트). 소진 후에는 '광고 보고 이어가기'로 연장.
# 테스트로 게이트를 빨리 보고 싶으면 2~3 으로 낮추세요.
FREE_CHATS_PER_DAY=5
# 광고 1회 시청 시 개방되는 대화 수 / 함께 지급하는 포인트.
CHAT_AD_UNLOCK_COUNT=5
CHAT_AD_REWARD=20

# 공급사 postback 검증용 HMAC 시크릿(공급사별로 분리해야 하나 MVP에선 공통)
SUPPLIER_HMAC_SECRET=dev-supplier-secret-change-me

# 클릭 서명 시크릿
CLICK_SIGNING_SECRET=dev-click-secret-change-me

# 쿠폰 공급자 동작 강제(정상 saga 시연용): success | fail | unknown
COUPON_PROVIDER_MODE=success

# 수익화 소스: sample(내장 샘플 카탈로그·광고망, 기본) | live(실제 제휴 API — 추후 연동)
# 실연동 방법은 docs/MONETIZATION.md 참고
MONETIZATION_MODE=sample

# --- 인증/보안 ---
# 실행 환경. production 이면 x-user-id 헤더 인증과 dev 엔드포인트가 자동 비활성.
NODE_ENV=development
# 세션 토큰 서명 비밀(운영에선 반드시 강한 값으로 교체)
SESSION_SECRET=dev-session-secret-change-me
# 세션 유효기간(초). 기본 30일
SESSION_TTL_SEC=2592000
# dev 편의: Bearer 없이 x-user-id 헤더 인증 허용(운영 자동 false)
ALLOW_HEADER_AUTH=true
# dev 전용 엔드포인트(전환 시뮬레이터, OTP 코드 노출) 활성(운영 자동 false)
ENABLE_DEV_ENDPOINTS=true
# 쓰기 API 분당 요청 상한(IP+사용자)
WRITE_RATE_LIMIT_PER_MIN=120
