# 혜택AI MVP 환경변수 예시 — 실제 값은 .env 로 복사해서 사용하세요.

# 서버 포트
PORT=3000

# AI 공급자(Model Gateway). 비워두면 결정형 mock 답변으로 동작합니다(키 없이 실행 가능).
# 실제 Claude를 붙이려면 아래 두 값을 채우세요.
ANTHROPIC_API_KEY=
# 답변 모델 등급(balanced=최신 기본, reasoning=고난도, fast=저비용). 자세한 매핑은 src/modules/ai/provider.ts 참고
AI_MODEL_TIER=balanced

# 공급사 postback 검증용 HMAC 시크릿(공급사별로 분리해야 하나 MVP에선 공통)
SUPPLIER_HMAC_SECRET=dev-supplier-secret-change-me

# 클릭 서명 시크릿
CLICK_SIGNING_SECRET=dev-click-secret-change-me

# 쿠폰 공급자 동작 강제(정상 saga 시연용): success | fail | unknown
COUPON_PROVIDER_MODE=success
